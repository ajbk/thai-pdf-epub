# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ API key จริง
# รับ key ได้ที่ https://playground.opentyphoon.ai (เมนู API Keys)
TYPHOON_OCR_API_KEY=your_typhoon_api_key_here

# (ไม่บังคับ) เปลี่ยน base URL หรือชื่อโมเดลได้
# TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
# TYPHOON_OCR_MODEL=typhoon-ocr

# === โหมด Local (Ollama) — เร็วกว่า ไม่มี rate limit ===
# รัน Typhoon OCR ในเครื่องด้วย Ollama แล้วชี้แอปมาที่นี่ (ดู README หัวข้อ "รันแบบ Local")
# TYPHOON_OCR_API_KEY ใส่อะไรก็ได้ (Ollama ไม่ตรวจ) แต่ต้องไม่ว่าง
# TYPHOON_BASE_URL=http://127.0.0.1:11434/v1
# TYPHOON_OCR_MODEL=scb10x/typhoon-ocr1.5-3b
# NEXT_PUBLIC_OCR_MIN_INTERVAL_MS=300   # local ไม่ต้องหน่วง 3.2s/หน้า
